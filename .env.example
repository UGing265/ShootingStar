# ShootingStar Database Configuration Example
SHOOTINGSTAR_DATABASE_URL=postgresql+psycopg2://username:password@127.0.0.1:5432/shootingstar_db
SHOOTINGSTAR_TEST_DATABASE_URL=postgresql+psycopg2://username:password@127.0.0.1:5432/shootingstar_test_db

# External Model API (Gemini) Configuration
# Option A: Single Key
# GEMINI_API_KEY=AIzaSyYourGeminiKeyHere
# Option B: Multiple Keys (comma-separated, auto-assigned independent project slots)
# SHOOTINGSTAR_GEMINI_KEYS=AIzaSyKey1,AIzaSyKey2,AIzaSyKey3
# Option C: Multiple Keys with explicit Google Cloud project names
# SHOOTINGSTAR_GEMINI_KEYS=AIzaSyKey1:project_alpha,AIzaSyKey2:project_beta

# Cooldown duration in seconds when a project receives HTTP 429 (Default: 60)
SHOOTINGSTAR_GEMINI_COOLDOWN_SECONDS=60

# External API Gate & Admin Auth
SHOOTINGSTAR_EXTERNAL_API_ENABLED=true
SHOOTINGSTAR_ADMIN_KEY=change_this_to_a_secure_admin_key
